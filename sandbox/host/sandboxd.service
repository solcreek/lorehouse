# systemd unit for sandboxd. Install (README.md, "Set up"):
#   sudo install -m 0755 target/release/sandboxd /usr/local/bin/sandboxd
#   sudo install -m 0600 sandboxd.env /etc/lorehouse/sandboxd.env   # see README.md
#   sudo install -m 0644 sandboxd.sysctl.conf /etc/sysctl.d/90-lorehouse-sandboxd.conf
#   sudo install -m 0644 sandboxd.modules.conf /etc/modules-load.d/lorehouse-sandboxd.conf
#   sudo sysctl --system && sudo systemctl restart systemd-modules-load
#   sudo install -m 0644 sandboxd.service /etc/systemd/system/
#   sudo systemctl enable --now sandboxd
#
# sandboxd runs model-written code in microVMs, so this unit assumes a guest may break
# out of one: whatever a broken-out guest lands in should hold as little as possible.
# Score: `systemd-analyze security sandboxd`. src/service_unit.rs checks the directives
# below, so dropping one fails `cargo test`.
[Unit]
Description=Lorehouse sandbox host (Firecracker microVMs)
After=network-online.target systemd-sysctl.service systemd-modules-load.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sandboxd
EnvironmentFile=/etc/lorehouse/sandboxd.env
# The token as a systemd credential (README.md, "Tokens"): a root-only file systemd hands
# to sandboxd alone, never in any process's environment. Read before SANDBOXD_RUNNER_TOKEN
# (still accepted, with a warning). To switch: write the token to the file (root, 0600),
# uncomment this line, remove SANDBOXD_RUNNER_TOKEN from sandboxd.env, restart. A line
# naming a missing file fails the start. Serve mode: LoadCredential=api-token:<file>.
#LoadCredential=runner-token:/etc/lorehouse/sandboxd-runner-token
Restart=on-failure
RestartSec=5
# SIGTERM stops every VM cleanly (sync first, disks kept) and removes its network rules:
# requests in flight get 30 s, then all VMs stop at once (≤ 20 s each), well under this.
KillSignal=SIGTERM
# Only sandboxd gets the SIGTERM; it stops each VM itself, after the guest's sync.
# KillMode=control-group (the default) would also send it to every Firecracker at once,
# and Firecracker dies on SIGTERM, before the guest has flushed its disk cache. Whatever
# is left at TimeoutStopSec is SIGKILLed.
KillMode=mixed
TimeoutStopSec=120

# Root, but only for what it does: taps and nftables rules (CAP_NET_ADMIN), and the
# jailer, which builds each VM's chroot (SYS_ADMIN for its mount namespace and
# pivot_root, SYS_CHROOT, MKNOD for /dev/kvm and /dev/net/tun in it, CHOWN), then drops
# to the VM's uid (SETUID, SETGID). sandboxd reaches into a jail, owned by that uid, for
# the vsock and to clean up (DAC_OVERRIDE), and signals the jailed VMM (KILL). The VMM
# itself ends with no capability at all.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_CHOWN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_KILL
# The jailer drops privileges with setuid(2), which NoNewPrivileges doesn't stop.
NoNewPrivileges=yes
# Each VM gets its own cgroup (CPU, memory, pids, IO limits) under this unit's, and
# systemd's stop reaches the VMs too. Hence no ProtectControlGroups=: delegated cgroups
# must be writable.
Delegate=yes
# Read-only everywhere but the state directory (sandbox disks, mirrors, runner ledger),
# which systemd creates (0700) and makes writable. For a different SANDBOXD_STATE add
# ReadWritePaths=<it> (it must exist): sandboxd refuses to start when its state
# directory isn't writable. The golden and the guest kernel are only read, and must not
# be under /home or /root (ProtectHome).
ProtectSystem=strict
StateDirectory=lorehouse-sandboxes
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
UMask=0077
# /dev/kvm for the VMs and /dev/net/tun for their taps; beyond those, only the
# standard pseudo-devices (null, zero, random, …) DevicePolicy=closed keeps. "m": the
# jailer makes its own nodes of them (and of /dev/userfaultfd and /dev/urandom, when
# the host has them; it fails without /dev/userfaultfd's) inside each jail.
DevicePolicy=closed
DeviceAllow=/dev/kvm rwm
DeviceAllow=/dev/net/tun rwm
DeviceAllow=/dev/userfaultfd m
DeviceAllow=/dev/urandom m
# AF_INET/AF_INET6: Lorehouse and GitHub. AF_UNIX: each VM's vsock and API sockets.
# AF_NETLINK: ip and nft.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# The jailer's mount namespace, and no other.
RestrictNamespaces=mnt
# net.ipv4.ip_forward comes from sandboxd.sysctl.conf at boot (sandboxd checks it is on
# and refuses to start otherwise), and nft's modules from sandboxd.modules.conf.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# @mount: the jailer's mount, pivot_root and chroot. seccomp: Firecracker installs its
# own, much narrower filter per thread on top of this one, with seccomp(2). systemd 255
# (Ubuntu 24.04 LTS) leaves seccomp out of @system-service, and without it every VM
# fails to boot ("Failed to set the requested seccomp filters", #122).
SystemCallFilter=@system-service @mount seccomp
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

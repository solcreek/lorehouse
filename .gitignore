node_modules/
dist/
*.db
*.db-wal
*.db-shm
*.db-journal
*.log

# Secrets. This repo is public. settings.json is what `lorehouse setup` and the Slack
# install write beside the database, the working directory by default: the Slack app's
# credentials, the bot token, the Anthropic key. (Its temp file too, if a write dies.)
.env
.env.*
.dev.vars
lorehouse.env
settings.json
settings.json.*.tmp
# A tenant's directory (src/tenant.ts), made beside the databases in the working directory
# by default: its databases are ignored above, and this is the rest of it.
tenant.json
tenant.json.*.tmp
# What an interrupted or careful upgrade can leave (src/tenant.ts): a set-aside side file,
# which holds the database's pages and so its messages, and the temporary rollback link.
*.db-wal.stale-*
*.db-shm.stale-*
*.db-journal.stale-*
*.tenant-link
!/.claude/settings.json
*.pem

# Research scratch space (benchmark builds, node_modules, raw result JSON).
# Its conclusions live in docs/experiments/. (Root-anchored: a bare `experiments/`
# would also hide docs/experiments/.)
/experiments/

# Rust build output (sandbox/host)
target/

# Proof from .claude/skills/verify-lorehouse. Cleanup leaves these in place.
.claude/skills/verify-lorehouse/artifacts/

# nix build output
/result
/result-*

# Claude Code agent worktrees
.claude/worktrees/
